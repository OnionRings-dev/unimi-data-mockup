              </div>
      
            
    
    <div id="edit-group-course-attendance--content" class="panel-body panel-collapse collapse fade">
            
            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-bcd3337bedb15eb6bdd31ef9da959d15bee0f11de1973deeab14e2821e698857">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-field-frequenza"><div class="field-content">Attendance is strongly recommended.</div></div></div>

