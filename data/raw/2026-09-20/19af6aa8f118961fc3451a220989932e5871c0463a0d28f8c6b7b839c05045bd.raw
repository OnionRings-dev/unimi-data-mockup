            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-blocco-action field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_47 js-view-dom-id-e1704f4e359d193464e366eb61d2ef1d7e7fd8aa708b10efcda28048ab88ec10">
  
    
      
