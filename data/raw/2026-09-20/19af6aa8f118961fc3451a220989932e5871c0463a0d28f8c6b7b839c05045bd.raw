                  <div class="tab-content">
                          <div id="ugov-of-pd-year-af-20270000cacof2-CAC-0-0" class="tab-pane fade in active">
                
                                  
                                          
                                              <div class="top30 titoletto">Obbligatorio</div>
                                                <table class="no-more-tables rs_content">
                          <thead>
                            <tr>
                              <th scope="col">Attività formative</th>
