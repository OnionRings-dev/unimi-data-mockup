          <div class="views-row"><div class="views-field views-field-view"><span class="field-content"><div class="view view-paragrafi view-id-paragrafi view-display-id-block_1 js-view-dom-id-2f1e548cb6889c3b3230c0b3070c7a292661e9faf63093a2a5c1835e3cf3326a">
  
    
      
      <div class="view-content">
