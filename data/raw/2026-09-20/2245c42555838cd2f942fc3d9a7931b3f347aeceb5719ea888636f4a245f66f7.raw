                          <a aria-controls="edit-group-organizzazione-e-didattica--content" aria-expanded="false" aria-pressed="false" data-toggle="collapse" role="button" class="panel-title" href="#edit-group-organizzazione-e-didattica--content">Organizzazione didattica</a>
              </div>
      
            
    
    <div id="edit-group-organizzazione-e-didattica--content" class="panel-body panel-collapse collapse fade">
            
            <div class="field field--name-ugov-organizzazione field--type-text-long field--label-hidden field--item"><div class="af-edition-sector">
<!-- 5000 -->
MATH-02/B - Geometria - CFU: 5<br>
<!-- 4000 -->
MATH-03/A - Analisi matematica - CFU: 4<br>
</div>


<div class="af-edition-didactictype">
