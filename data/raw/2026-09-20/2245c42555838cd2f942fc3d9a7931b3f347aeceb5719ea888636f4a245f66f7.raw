      <h3 class="js-views-accordion-group-header">Gruppo 2</h3>
      <div class="views-row">
    <div class="row bs-1col ugov-of ugov-of--type-afed ugov-of--view-mode-full">
  
  <div class="bs-region bs-region--main">
    
