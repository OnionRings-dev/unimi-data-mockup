<div  class="paragraph paragraph--type--bp-accordion">
    <div class="js-form-wrapper form-wrapper form-item js-form-item panel panel-default" id="bootstrap-panel--5">

              <div class="panel-heading">
                          <a aria-controls="bootstrap-panel--5--content" aria-expanded="false" aria-pressed="false" data-toggle="collapse" role="button" class="panel-title" href="#bootstrap-panel--5--content">Corsi di laurea che utilizzano l'insegnamento</a>
