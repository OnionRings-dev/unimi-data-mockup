            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-piano-didattico field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_12 js-view-dom-id-c34211f2d4b9746a25d5fad4c96523ad83097478a1d9279de96982fe70cf24b8">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-rendered-entity"><span class="field-content">  <div class="layout layout--onecol">
    <div  class="layout__region layout__region--content">
      
            <div class="field field--name-ugov-piano-didattico field--type-map field--label-hidden field--item"><div class="ugov_of_pd ugov_of_pd_type_2 ugov_of_pd_it">

<div class="accordion bottom40 js-form-wrapper form-wrapper form-item js-form-item panel panel-default" id="curr-accordion">
    <div>
    <!-- curr_default 1 - curr_number  - curr_tot_number 1 -->

    <div class="panel-heading">
      <a data-toggle="collapse" data-parent="#curr-accordion" class="panel-title" aria-expanded="false" aria-controls="curr-20270000fafof2-FAF-0" role="button" href="#curr-20270000fafof2-FAF-0">
                  Piano didattico
              </a>
    </div>

    <div id="curr-20270000fafof2-FAF-0" class="panel-collapse collapse ">
