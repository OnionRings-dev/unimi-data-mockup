    <div id="bootstrap-panel--11--content" class="panel-body panel-collapse collapse fade">
            
            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-elenco-cdsi field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi view-id-w4_cdsi view-display-id-block_12 js-view-dom-id-f4f1712f1af4d01b60d23d35597ea0eb230bfd1e179f73d7b8ae47057c2cbf3e">
  
    
      
      <div class="view-content">
          <div class="area-"><div class="view view-w4-cdsi view-id-w4_cdsi view-display-id-block_11 js-view-dom-id-94daf859f5fd6b7e65dc50b7a5923b659e0e1641535a65ad786061065f75e67d">
  
    
      
