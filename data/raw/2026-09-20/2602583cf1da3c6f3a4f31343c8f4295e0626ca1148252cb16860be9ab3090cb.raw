<div  class="paragraph paragraph--type--bp-accordion paragraph__column">
  <div class="bp-title">Manifesto ed elenco insegnamenti</div>
          <div  class="bottom20">
        
            <div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_3 js-view-dom-id-cb2330206bd1caf4570af4ec0de30148f2ba806a71398eae48b2c02734ee0c9e">
  
    
      
      <div class="view-content">
          <div class="padl30 views-row"><div><span class="file">
  <span class="file-icon" aria-hidden="true">
    <span class="far fa-file"></span>
  </span>
  <span class="file-link"><a href="https://apps.unimi.it/files/manifesti/ita_manifesto_FBPof2_2027.pdf">Manifesto degli studi [FBPof2_2027]</a></span>
</span></div></div>

