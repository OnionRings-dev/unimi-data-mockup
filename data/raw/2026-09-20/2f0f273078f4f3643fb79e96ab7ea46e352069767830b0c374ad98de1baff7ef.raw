            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-e88fbf8cf89e62e6ee733c1002ac551028327dcf2e7ec6a40e0d84b2026bddd1">
  
    
      
