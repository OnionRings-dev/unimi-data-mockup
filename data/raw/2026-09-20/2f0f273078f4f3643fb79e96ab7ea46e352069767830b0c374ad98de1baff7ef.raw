    <div class="field--label">Presidente del Collegio didattico</div>
              <div class="field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_33 js-view-dom-id-2807a485feb599fac768f0d0bd85e3041dfc9255ac4167ff7494849b48949a8d">
  
    
      
