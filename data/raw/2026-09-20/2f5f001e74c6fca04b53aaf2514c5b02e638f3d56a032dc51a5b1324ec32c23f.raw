            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-984f01b87bddef740feca639c4c9cb0d375fb4908bcfbfad76dc5ba7773590da">
  
    
      
      <div class="view-content">
