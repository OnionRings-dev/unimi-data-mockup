              </div>
      
            
    
    <div id="edit-group-course-attendance--content" class="panel-body panel-collapse collapse fade">
            
            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-5258003dbf43571184c9e80a10e1c0192c73be639652acf353900f794c1ca9df">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-field-frequenza"><div class="field-content">Attendance is strongly recommended but not compulsory.</div></div></div>

