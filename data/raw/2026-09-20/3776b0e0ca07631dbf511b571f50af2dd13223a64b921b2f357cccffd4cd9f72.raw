            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-ec86777ab02a4d0bac256b3602b9a3f3e10537276cf906ef899f141d5fe1e41f">
  
    
      
      <div class="view-content">
