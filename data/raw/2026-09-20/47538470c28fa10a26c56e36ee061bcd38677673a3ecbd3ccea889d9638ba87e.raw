            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-e5b974dc8bf8df9d4fec8147ae343b55375a77319af47ba84e99d1dd395ed1d6">
  
    
      
