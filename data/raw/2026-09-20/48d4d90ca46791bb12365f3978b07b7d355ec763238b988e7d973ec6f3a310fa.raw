                        </thead>
                        <tbody>
                                                      <tr class="rowsubtitle ugov-of-pd-level2"><td colspan="5">Obbligatorio</td></tr>

                                                          <tr>
                                <td class="cdl-title" data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/contemporary-history">Contemporary history</a>
</td>
<td data-title="Crediti massimi">6</td>
