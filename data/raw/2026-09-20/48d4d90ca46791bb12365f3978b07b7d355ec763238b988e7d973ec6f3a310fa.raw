                  <div class="tab-content">
                          <div id="ugov-of-pd-year-af-20270000bafof2-BAF-A-0" class="tab-pane fade in active">
                
                                  
                                          <div class="top30 titoletto">Primo trimestre</div>
                                            <table class="no-more-tables rs_content">
                        <thead>
                          <tr>
                            <th scope="col">Attività formative</th>
                            <th scope="col">Crediti massimi</th>
                            <th scope="col">Ore totali</th>
                            <th scope="col">Lingua</th>
