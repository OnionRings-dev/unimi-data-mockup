<td data-title="SSD">HIST-03/A</td>

                              </tr>
                                                          <tr>
                                <td class="cdl-title" data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/data-analysis-0">Data analysis</a>
</td>
<td data-title="Crediti massimi">3</td>
<td data-title="Ore totali">20</td>
<td data-title="Lingua">Inglese</td>
<td data-title="SSD">INFO-01/A</td>

                              </tr>
                                                          <tr>
                                <td class="cdl-title" data-title="Attività formative">
