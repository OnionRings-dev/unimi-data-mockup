            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-piano-didattico field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_12 js-view-dom-id-9292d2b744a51fb86eaf59ac4456a2181705e41b625c509a7c6f9cd8c5d75a7c">
  
    
      
      <div class="view-content">
