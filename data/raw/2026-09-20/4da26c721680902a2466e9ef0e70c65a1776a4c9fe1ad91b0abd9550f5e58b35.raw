<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/istituzioni-di-storia-dellarte-0">Istituzioni di storia dell&#039;arte</a>
</td>
<td data-title="Crediti massimi">9</td>
<td data-title="Ore totali">60</td>
<td data-title="Lingua">Italiano</td>
<td data-title="Periodo">Primo semestre</td>
<td data-title="SSD">ARTE-01/D</td>

