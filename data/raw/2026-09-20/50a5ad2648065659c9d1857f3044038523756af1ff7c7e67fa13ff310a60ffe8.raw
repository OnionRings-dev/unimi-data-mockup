      <div class="view-content">
        <h3>A.A. 2026/2027</h3>
    <div class="views-row"><div class="views-field views-field-title-1"><span class="field-content"><a href="/it/corsi/altre_offerte/aa-2026/2027/matematica-classe-lm-40-r-immatricolati-nellaa-2026/2027" hreflang="it">Matematica (Classe LM-40 R )-immatricolati nell&#039;a.a. 2026/2027</a> [FBQof2 2027]</span></div></div>
