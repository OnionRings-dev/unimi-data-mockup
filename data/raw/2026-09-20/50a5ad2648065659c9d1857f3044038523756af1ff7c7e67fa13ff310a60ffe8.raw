                                                          <tr>
                                <td class="cdl-title" data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/algebra-combinatoria">Algebra combinatoria</a>
</td>
<td data-title="Crediti massimi">6</td>
<td data-title="Ore totali">42</td>
