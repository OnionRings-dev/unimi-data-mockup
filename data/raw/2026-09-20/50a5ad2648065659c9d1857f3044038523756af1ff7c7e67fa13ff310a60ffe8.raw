            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-b08f4da9bc4e301a97339fc4e6b35a2b9714de3c04b9799d911c06691e6a9a1f">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-field-frequenza"><div class="field-content">La frequenza alle attività didattiche di ogni singolo insegnamento è fortemente consigliata.</div></div></div>

