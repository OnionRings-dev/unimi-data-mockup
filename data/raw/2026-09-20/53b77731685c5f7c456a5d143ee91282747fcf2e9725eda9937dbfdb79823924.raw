            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-blocco-action field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_47 js-view-dom-id-90f53a7f8b003210ad53b7bc6ec024ecac8954b89f99f270e99891149490af94">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-view"><span class="field-content"><div class="view view-paragrafi view-id-paragrafi view-display-id-block_1 js-view-dom-id-8c9af4df8fa4738f6c66f56ca188a3b2ece37259db693954b8391ded13594d9a">
  
    
      
