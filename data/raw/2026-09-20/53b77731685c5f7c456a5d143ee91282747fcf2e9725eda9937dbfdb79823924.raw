              </div>
      
            
    
    <div id="edit-group-course-attendance--content" class="panel-body panel-collapse collapse fade">
            
            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-ecfe1c15c5197457a0719a5387912e80e4a987ba3e89b870e14e5ea78f0cb5ee">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-field-frequenza"><div class="field-content">La frequenza è obbligatoria per tutti i corsi previsti dal piano degli studi.</div></div></div>

