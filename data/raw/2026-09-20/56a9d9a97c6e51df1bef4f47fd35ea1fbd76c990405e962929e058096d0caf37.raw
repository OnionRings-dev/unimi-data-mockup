            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-elenco-cdsi field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi view-id-w4_cdsi view-display-id-block_12 js-view-dom-id-413369ce4588ce57ef9818e97ebc945c5e44db0715af20412add1ab6cf28d0a3">
  
    
      
      <div class="view-content">
          <div class="area-"><div class="view view-w4-cdsi view-id-w4_cdsi view-display-id-block_11 js-view-dom-id-e94034ec769eba0732821856fcbcab4de3d2b56f958cc1e801e8d6430b1d062c">
  
    
      
      <div class="view-content">
