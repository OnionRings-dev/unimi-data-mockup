            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-piano-didattico field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_12 js-view-dom-id-eb7095c2a415e618b53b0b09660437e2a144a02906db8a89b9d48db549d9f310">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-rendered-entity"><span class="field-content">  <div class="layout layout--onecol">
    <div  class="layout__region layout__region--content">
      
            <div class="field field--name-ugov-piano-didattico field--type-map field--label-hidden field--item"><div class="ugov_of_pd ugov_of_pd_type_6 ugov_of_pd_it">

<div class="accordion bottom40 js-form-wrapper form-wrapper form-item js-form-item panel panel-default" id="curr-accordion">
  	

	<div>
		<div class="panel-heading">
			<a data-toggle="collapse" data-parent="#curr-accordion" class="panel-title" aria-expanded="false" aria-controls="curr-20270000cbcof2-CBC-A" role="button" href="#curr-20270000cbcof2-CBC-A">
									Curriculum: CRITICA DEL CONTEMPORANEO: PROSPETTIVE E GENEALOGIE
							</a>
		</div>
		<div id="curr-20270000cbcof2-CBC-A" class="panel-collapse collapse">
			<div class="panel-body">
				<div class="titoletto">Anno di corso a scelta dello studente</div>
				<hr />

															<div class="ugov-of-pd-special-i">
							<div class="special-i">Insegnamenti obbligatori</div>
							<table class="no-more-tables rs_content">
								<thead>
									<tr>
										<th scope="col">Attività formative</th>
										<th scope="col">Crediti massimi</th>
										<th scope="col">Ore totali</th>
										<th scope="col">Lingua</th>
										<th scope="col">Periodo</th>
										<th scope="col">SSD</th>
									</tr>
								</thead>
								<tbody>
																			<tr class="ugov-of-pd-special-af">
											<td data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/accertamento-di-lingua-inglese-livello-b2-3-cfu">Accertamento di lingua inglese - livello b2 (3 CFU)</a>
</td>
<td data-title="Crediti massimi">3</td>
<td data-title="Ore totali">0</td>
<td data-title="Lingua">Inglese</td>
<td data-title="Periodo">Periodo non definito</td>
<td data-title="SSD">NN</td>

										</tr>
																			<tr class="ugov-of-pd-special-af">
											<td data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/filosofia-delle-pratiche-0">Filosofia delle pratiche</a>
</td>
