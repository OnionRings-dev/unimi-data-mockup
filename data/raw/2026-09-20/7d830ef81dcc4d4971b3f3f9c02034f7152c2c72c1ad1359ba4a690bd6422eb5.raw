      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-view"><span class="field-content"><div class="view view-paragrafi view-id-paragrafi view-display-id-block_1 js-view-dom-id-88d915d645d6780b6618717c50269886de6ec6079c377bfcc63cef356a2a36df">
  
    
      
      <div class="view-content">
