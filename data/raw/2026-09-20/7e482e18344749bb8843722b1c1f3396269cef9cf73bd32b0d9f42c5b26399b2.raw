<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/scienza-delle-finanze-1">Scienza delle finanze</a>
</td>
<td data-title="Crediti massimi">6</td>
<td data-title="Ore totali">42</td>
<td data-title="Lingua">Italiano</td>
<td data-title="Periodo">Primo semestre</td>
<td data-title="SSD">ECON-03/A</td>

