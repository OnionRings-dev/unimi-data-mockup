              <div class="panel-heading">
                <a data-toggle="collapse" data-parent="#curr-accordion" class="panel-title top30" aria-expanded="false" aria-controls="curr-20270000aaaof2-AAA-B-p" role="button" href="#curr-20270000aaaof2-AAA-B-p">Propedeuticità del curriculum</a>
