            <div class="field field--name-field-presentazione-del-corso field--type-text-long field--label-hidden field--item"><p>Video del corso</p></div>
      
            <div class="field field--name-field-video-cdl field--type-entity-reference field--label-hidden field--item"><div class="media media--type-remote-video media--view-mode-full ds-1col clearfix">

  

        <div >
        
            <iframe src="/it/media/oembed?url=https%3A//youtu.be/l41xnwLDFWk&amp;max_width=800&amp;max_height=600&amp;type=remote_video&amp;provider=youtube&amp;view_mode=full&amp;hash=f8gGMbzCWlCb8M9hgzFwqohJWFso7WPiI9PH3_BTVQo" frameborder="0" allowtransparency width="800" height="600" loading="lazy" class="media-oembed-content" title="Laurea magistrale in biogeoscienze"></iframe>

      
  
