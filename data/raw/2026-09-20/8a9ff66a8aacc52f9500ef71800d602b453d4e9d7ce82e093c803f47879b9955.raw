            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-blocco-action field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_47 js-view-dom-id-3ada9c25451170eacd07d402232c9699b19a991acb4e18a015e657f893b90ab7">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-view"><span class="field-content"><div class="view view-paragrafi view-id-paragrafi view-display-id-block_1 js-view-dom-id-79d4d59df6d5ee9f35b462f5f6f5f3af5f64be2eb58919f49d859176b0c5e2b0">
  
    
      
      <div class="view-content">
