      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-view"><span class="field-content"><div class="view view-paragrafi view-id-paragrafi view-display-id-block_1 js-view-dom-id-1c81aa64dff4c165456eca182296c87cbe48ec74725c3f7708d7c7ac2d745478">
  
    
      
