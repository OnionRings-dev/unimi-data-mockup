<div  class="paragraph paragraph--type--bp-accordion paragraph__column">
  <div class="bp-title">Manifesto ed elenco insegnamenti</div>
          <div  class="bottom20">
        
            <div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_3 js-view-dom-id-bc6b3968e7b413ffe2828d0106f93447fad599e6d28f981e1e0aec20460e3f45">
  
    
      
      <div class="view-content">
          <div class="padl30 views-row"><div><span class="file">
  <span class="file-icon" aria-hidden="true">
    <span class="far fa-file"></span>
  </span>
  <span class="file-link"><a href="https://apps.unimi.it/files/manifesti/ita_manifesto_BBDof2_2027.pdf">Manifesto degli studi [BBDof2_2027]</a></span>
</span></div></div>

