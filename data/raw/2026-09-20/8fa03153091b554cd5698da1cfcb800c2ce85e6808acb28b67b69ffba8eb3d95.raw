<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/metodi-lo-studio-della-salute-0">Metodi per lo studio della salute</a>
</td>
<td data-title="Crediti massimi">3</td>
<td data-title="Ore totali">20</td>
<td data-title="Lingua">Italiano</td>
<td data-title="Periodo">Primo trimestre</td>
<td data-title="SSD">GSPS-05/A</td>

                                </tr>
