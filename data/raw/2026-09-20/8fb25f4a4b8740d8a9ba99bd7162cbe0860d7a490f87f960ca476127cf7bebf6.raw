            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-3b10e0e22252a43be4fe6b748b92f5a4ffc9b9e0d18096e85ba80bc59ed1ea73">
  
    
      
