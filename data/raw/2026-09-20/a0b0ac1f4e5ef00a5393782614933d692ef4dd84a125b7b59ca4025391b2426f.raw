<div  class="paragraph paragraph--type--bp-accordion paragraph__column">
  <div class="bp-title">Manifesto ed elenco insegnamenti</div>
          <div  class="bottom20">
        
            <div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_3 js-view-dom-id-017e2827ba4ca5bbfdb6a64699779d35a465b6d09bec87e901ef00ccf82eb65d">
  
    
      
      <div class="view-content">
