            <span class="file file--mime-application-pdf file--application-pdf icon-before"><span class="file-icon" aria-hidden="true"><span class="far fa-file"></span></span><span class="file-link"><a href="https://www.unimi.it/sites/default/files/2025-10/CBD%20LM-37%20Lingue%20e%20letterature%20per%20la%20formazione%2C%20la%20critica%20e%20la%20tr.pdf" type="application/pdf; length=869978" title="CBD LM-37 Lingue e letterature per la formazione, la critica e la tr.pdf [849.59 KB] - the file opens in new window" target="_blank">Regolamento didattico</a></span></span>
      
  
