            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-piano-didattico field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_12 js-view-dom-id-47c17db57d4dc415ee00bd7f566a2c1e30f5e0c74985e404851bbe070fdae0af">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-rendered-entity"><span class="field-content">  <div class="layout layout--onecol">
    <div  class="layout__region layout__region--content">
      
            <div class="field field--name-ugov-piano-didattico field--type-map field--label-hidden field--item"><div class="ugov_of_pd ugov_of_pd_type_2 ugov_of_pd_it">

<div class="accordion bottom40 js-form-wrapper form-wrapper form-item js-form-item panel panel-default" id="curr-accordion">
      <div>
    <!-- curr_default 0 - curr_number  - curr_tot_number 3 -->

    <div class="panel-heading">
      <a data-toggle="collapse" data-parent="#curr-accordion" class="panel-title" aria-expanded="false" aria-controls="curr-20270000gbbof2-GBB-A" role="button" href="#curr-20270000gbbof2-GBB-A">
                  Curriculum: Development and innovation in the food system
              </a>
    </div>

    <div id="curr-20270000gbbof2-GBB-A" class="panel-collapse collapse ">
      <div class="panel-body">

                  <ul class="nav nav-tabs ugov-of-pd-years">
                          <li class="active"><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000gbbof2-GBB-A-0"><div>

  Anno: 1
</div>
</a></li>
                          <li><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000gbbof2-GBB-A-1"><div>

  Anno: 2
</div>
</a></li>
                          <li><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000gbbof2-GBB-A-2"><div>

  Anno di corso a scelta dello studente
</div>
</a></li>
                      </ul>
        
                  <div class="tab-content">
                          <div id="ugov-of-pd-year-af-20270000gbbof2-GBB-A-0" class="tab-pane fade in active">
                
                                                                            <div class="top30 titoletto">Primo semestre</div>
                                            <table class="no-more-tables rs_content">
                        <thead>
                          <tr>
                            <th scope="col">Attività formative</th>
                            <th scope="col">Crediti massimi</th>
                            <th scope="col">Ore totali</th>
                            <th scope="col">Lingua</th>
                            <th scope="col">SSD</th>
                          </tr>
                        </thead>
                        <tbody>
                                                      <tr class="rowsubtitle ugov-of-pd-level2"><td colspan="5">Obbligatorio</td></tr>

                                                          <tr>
                                <tr><td class="cdl-title" data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/economia-e-politiche-del-sistema-alimentare">Economia e politiche del sistema alimentare</a>
</td>
<td data-title="Crediti massimi">7</td>
<td data-title="Ore totali">56</td>
<td data-title="Lingua">Italiano</td>
<td data-title="SSD">AGRI-01/A</td>
</tr>

                              </tr>
