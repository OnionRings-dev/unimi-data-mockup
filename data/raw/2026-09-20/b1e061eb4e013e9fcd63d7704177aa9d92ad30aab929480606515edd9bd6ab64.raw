            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-0e92f9de25534aa7df3f25311895ff260d752c8180a9629edfaed918a7b3ff91">
  
    
      
      <div class="view-content">
