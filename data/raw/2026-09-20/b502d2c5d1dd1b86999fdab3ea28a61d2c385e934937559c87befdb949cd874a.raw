            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-blocco-action field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_47 js-view-dom-id-7773fb0658d42fe3b215b763b04c496a35d53a6395ed004d20d42b6ee302cbbe">
  
    
      
