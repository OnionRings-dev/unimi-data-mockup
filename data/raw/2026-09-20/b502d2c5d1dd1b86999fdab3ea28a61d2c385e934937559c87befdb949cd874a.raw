              <li><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000bbcof2-BBC-A-2"><div>

  Anno di corso a scelta dello studente
</div>
</a></li>
                      </ul>
        
                  <div class="tab-content">
                          <div id="ugov-of-pd-year-af-20270000bbcof2-BBC-A-0" class="tab-pane fade in active">
                
                                  
                                          <div class="top30 titoletto">Primo trimestre</div>
                                            <table class="no-more-tables rs_content">
                        <thead>
                          <tr>
                            <th scope="col">Attività formative</th>
                            <th scope="col">Crediti massimi</th>
                            <th scope="col">Ore totali</th>
                            <th scope="col">Lingua</th>
                            <th scope="col">SSD</th>
                          </tr>
                        </thead>
                        <tbody>
                                                      <tr class="rowsubtitle ugov-of-pd-level2"><td colspan="5">Obbligatorio</td></tr>

                                                          <tr>
                                <td class="cdl-title" data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/comunicazione-e-cultura-digitale">Comunicazione e cultura digitale</a>
</td>
<td data-title="Crediti massimi">9</td>
<td data-title="Ore totali">60</td>
<td data-title="Lingua">Italiano</td>
<td data-title="SSD">GSPS-06/A</td>

                              </tr>
                            
                                                      <tr class="rowsubtitle ugov-of-pd-level2"><td colspan="5">Facoltativo</td></tr>

                                                          <tr>
                                <td class="cdl-title" data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/analisi-dei-dati">Analisi dei dati</a>
</td>
<td data-title="Crediti massimi">9</td>
<td data-title="Ore totali">60</td>
<td data-title="Lingua">Italiano</td>
<td data-title="SSD">GSPS-05/A</td>

