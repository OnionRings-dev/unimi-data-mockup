<div class="js-form-wrapper form-wrapper form-item js-form-item panel panel-default" id="edit-group-course-location">

              <div class="panel-heading">
                          <a aria-controls="edit-group-course-location--content" aria-expanded="true" aria-pressed="true" data-toggle="collapse" role="button" class="panel-title" href="#edit-group-course-location--content">Sede</a>
