            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-elenco-cdsi field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi view-id-w4_cdsi view-display-id-block_12 js-view-dom-id-3c928c66a4469cfeb1a00dff7806af33a6271d940a40b2391a120f2cd2c3f6f3">
  
    
      
      <div class="view-content">
          <div class="area-"><div class="view view-w4-cdsi view-id-w4_cdsi view-display-id-block_11 js-view-dom-id-7549f9ee12fb910b28fcf22a7e4e66401e1927ee3018570238f860a58ad2e799">
  
    
      
      <div class="view-content">
        <h3>A.A. 2026/2027</h3>
    <div class="views-row"><div class="views-field views-field-title-1"><span class="field-content"><a href="/it/corsi/altre_offerte/aa-2026/2027/valorizzazione-e-tutela-dellambiente-e-del-territorio-montano-classe-l-25-r-immatricolati-nellanno-0" hreflang="it">Valorizzazione e tutela dell&#039;ambiente e del territorio montano (Classe L-25 R)-immatricolati nell&#039;anno accademico 2026/2027</a> [GAAof2 2027]</span></div></div>
    <div class="views-row"><div class="views-field views-field-title-1"><span class="field-content"><a href="/it/corsi/altre_offerte/aa-2026/2027/valorizzazione-e-tutela-dellambiente-e-del-territorio-montano-classe-l-25-r-immatricolati-nellanno" hreflang="it">Valorizzazione e tutela dell&#039;ambiente e del territorio montano (Classe L-25 R)-immatricolati nell&#039;anno accademico 2025/26</a> [GAAof1 2027]</span></div></div>
