            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-piano-didattico field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_12 js-view-dom-id-39f27c189dea13f04139911394014e87b707c76d13c231f18c68131002dd5862">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-rendered-entity"><span class="field-content">  <div class="layout layout--onecol">
    <div  class="layout__region layout__region--content">
      
            <div class="field field--name-ugov-piano-didattico field--type-map field--label-hidden field--item"><div class="ugov_of_pd ugov_of_pd_type_3 ugov_of_pd_it">

<div class="accordion bottom40 js-form-wrapper form-wrapper form-item js-form-item panel panel-default" id="curr-accordion">
      <div>

    <div class="panel-heading">
      <a data-toggle="collapse" data-parent="#curr-accordion" class="panel-title" aria-expanded="false" aria-controls="curr-20270000badof2-BAD-A" role="button" href="#curr-20270000badof2-BAD-A">
                  Curriculum: PROCESSI GLOBALI
              </a>
    </div>
    <div id="curr-20270000badof2-BAD-A" class="panel-collapse collapse ">
      <div class="panel-body">

                  <ul class="nav nav-tabs ugov-of-pd-years">
            
              <li class="active"><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000badof2-BAD-A-0"><div>

  Anno: 1
</div>
</a></li>
            
              <li><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000badof2-BAD-A-1"><div>

  Anno: 2
</div>
</a></li>
            
              <li><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000badof2-BAD-A-2"><div>

  Anno: 3
</div>
</a></li>
            
              <li><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000badof2-BAD-A-3"><div>

  Anno di corso a scelta dello studente
</div>
