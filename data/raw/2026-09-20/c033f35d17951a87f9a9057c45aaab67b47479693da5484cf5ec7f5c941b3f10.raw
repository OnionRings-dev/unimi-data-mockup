            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-piano-didattico field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_12 js-view-dom-id-746a4ca71cf0c0b65a5087727c545ddce368709e607308224c8cac7402c5b394">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-rendered-entity"><span class="field-content">  <div class="layout layout--onecol">
    <div  class="layout__region layout__region--content">
      
            <div class="field field--name-ugov-piano-didattico field--type-map field--label-hidden field--item"><div class="ugov_of_pd ugov_of_pd_type_3 ugov_of_pd_it">

<div class="accordion bottom40 js-form-wrapper form-wrapper form-item js-form-item panel panel-default" id="curr-accordion">
      <div>

    <div class="panel-heading">
      <a data-toggle="collapse" data-parent="#curr-accordion" class="panel-title" aria-expanded="false" aria-controls="curr-20270000fbcof2-FBC-A" role="button" href="#curr-20270000fbcof2-FBC-A">
                  Curriculum: SCIENZE E TECNOLOGIE CHIMICO-ANALITICHE E CHIMICO-FISICHE
              </a>
    </div>
    <div id="curr-20270000fbcof2-FBC-A" class="panel-collapse collapse ">
      <div class="panel-body">

                  <ul class="nav nav-tabs ugov-of-pd-years">
            
              <li class="active"><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000fbcof2-FBC-A-0"><div>

  Anno: 1
</div>
</a></li>
            
              <li><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000fbcof2-FBC-A-1"><div>

  Anno: 2
</div>
</a></li>
            
              <li><a data-toggle="tab" href="#ugov-of-pd-year-af-20270000fbcof2-FBC-A-2"><div>

  Anno di corso a scelta dello studente
</div>
</a></li>
                      </ul>
        
                  <div class="tab-content">
                          <div id="ugov-of-pd-year-af-20270000fbcof2-FBC-A-0" class="tab-pane fade in active">
                
                                  
                                          <div class="top30 titoletto">Periodo non definito</div>
                                              <div class="top10 sottotitoletto">Per queste attività non è previsto un periodo di offerta.</div>
                                            <table class="no-more-tables rs_content">
                        <thead>
                          <tr>
                            <th scope="col">Attività formative</th>
                            <th scope="col">Crediti massimi</th>
                            <th scope="col">Ore totali</th>
                            <th scope="col">Lingua</th>
                            <th scope="col">SSD</th>
                          </tr>
                        </thead>
                        <tbody>
                                                      <tr class="rowsubtitle ugov-of-pd-level2"><td colspan="5">Obbligatorio</td></tr>

