                  <div class="tab-content">
                          <div id="ugov-of-pd-year-af-20270000fakof2-FAK-0-0" class="tab-pane fade in active">
                
                                                                            <div class="top30 titoletto">Su più periodi</div>
                                              <div class="top10 sottotitoletto">Queste attività sono divise su più periodi, consultare la scheda per i dettagli.</div>
                                            <table class="no-more-tables rs_content">
                        <thead>
                          <tr>
                            <th scope="col">Attività formative</th>
                            <th scope="col">Crediti massimi</th>
                            <th scope="col">Ore totali</th>
                            <th scope="col">Lingua</th>
                            <th scope="col">SSD</th>
                          </tr>
                        </thead>
                        <tbody>
                                                      <tr class="rowsubtitle ugov-of-pd-level2"><td colspan="5">Obbligatorio</td></tr>

                                                          <tr>
                                <tr><td class="cdl-title" data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/botanica-2">Botanica</a>
</td>
