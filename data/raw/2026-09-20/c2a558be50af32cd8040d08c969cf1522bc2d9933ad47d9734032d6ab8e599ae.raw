            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-piano-didattico field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_12 js-view-dom-id-9f9e5aaac993386911a5904f888b5eab8637ab2e8c3022c26ac398855644a06f">
  
    
      
      <div class="view-content">
