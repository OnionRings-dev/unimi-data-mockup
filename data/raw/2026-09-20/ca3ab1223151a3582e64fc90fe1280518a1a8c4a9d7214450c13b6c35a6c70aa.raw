              <div class="panel-heading">
                          <a aria-controls="edit-group-course-attendance--content" aria-expanded="false" aria-pressed="false" data-toggle="collapse" role="button" class="panel-title" href="#edit-group-course-attendance--content">Obbligo di frequenza</a>
              </div>
      
            
    
    <div id="edit-group-course-attendance--content" class="panel-body panel-collapse collapse fade">
            
            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-e1d4b630c09493b41c5d01fdea72a2f5da7a2adf882f36a82622f165b5883994">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-field-frequenza"><div class="field-content">Attendance at lessons is strongly recommended. Attendance to practical activities and exercises is mandatory; alternative activities will be offered to students who cannot attend for justified reasons.</div></div></div>

    </div>
  
