            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-elenco-cdsi field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi view-id-w4_cdsi view-display-id-block_12 js-view-dom-id-b4e486824f4309740a4ea5430d6b2ea4ac7e6986939d6309bacc50ad5a8c0d7d">
  
    
      
      <div class="view-content">
          <div class="area-"><div class="view view-w4-cdsi view-id-w4_cdsi view-display-id-block_11 js-view-dom-id-5b6976091b1bd19fb53168d81cc24c28fd82f9f6fe7ed1e0338da901001e15dd">
  
    
      
