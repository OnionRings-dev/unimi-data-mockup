<div  class="paragraph paragraph--type--bp-accordion paragraph__column">
  <div class="bp-title">Manifesto ed elenco insegnamenti</div>
          <div  class="bottom20">
        
            <div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_3 js-view-dom-id-c4b16859faec65eed0f5a680496451fd519c0f730def8076b631d25347c8afca">
  
    
      
      <div class="view-content">
          <div class="padl30 views-row"><div><span class="file">
  <span class="file-icon" aria-hidden="true">
    <span class="far fa-file"></span>
  </span>
  <span class="file-link"><a href="https://apps.unimi.it/files/manifesti/ita_manifesto_KBEof2_2027.pdf">Manifesto degli studi [KBEof2_2027]</a></span>
</span></div></div>

