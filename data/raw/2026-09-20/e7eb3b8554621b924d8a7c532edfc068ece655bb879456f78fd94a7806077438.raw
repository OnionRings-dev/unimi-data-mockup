            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-9b6c1a3e10c10e4b64bad158a2498f10da24afe43b28a4f5105d709e29ea55de">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-field-frequenza"><div class="field-content">La frequenza ai corsi e ai laboratori è fortemente consigliata.</div></div></div>

