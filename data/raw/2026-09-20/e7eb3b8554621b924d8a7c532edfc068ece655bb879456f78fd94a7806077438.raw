<div  class="paragraph paragraph--type--bp-accordion paragraph__column">
  <div class="bp-title">Manifesto ed elenco insegnamenti</div>
          <div  class="bottom20">
        
            <div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_3 js-view-dom-id-b6f8dfdd35d73bddab413221fe77b08942d2413c67183e9c2848248560516619">
  
    
      
      <div class="view-content">
          <div class="padl30 views-row"><div><span class="file">
  <span class="file-icon" aria-hidden="true">
    <span class="far fa-file"></span>
  </span>
  <span class="file-link"><a href="https://apps.unimi.it/files/manifesti/ita_manifesto_FBEof2_2027.pdf">Manifesto degli studi [FBEof2_2027]</a></span>
</span></div></div>

    </div>
  
