            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-piano-didattico field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_12 js-view-dom-id-e99cb2f885114b93201febd500146d3184ebba8094e1e5fe7c273ad88d08251a">
  
    
      
      <div class="view-content">
