  <td data-title="Attività formative propedeutiche">
Glottologia (obbligatoria)  </td>
</tr>
<tr>
  <td data-title="Attività formativa">Filologia slava</td>
  <td data-title="Attività formative propedeutiche">
Glottologia (obbligatoria)  </td>
</tr>
<tr>
  <td data-title="Attività formativa">Linguistica generale</td>
  <td data-title="Attività formative propedeutiche">
Glottologia (obbligatoria)  </td>
</tr>
</tbody>
</table>
</div>
</div>
