          <div class="views-row"><div class="views-field views-field-view"><span class="field-content"><div class="view view-paragrafi view-id-paragrafi view-display-id-block_1 js-view-dom-id-29d049badefbe80d23deb98f0aa08577c8466d1bff22ce55b81d71593c27c7f6">
  
    
      
      <div class="view-content">
