            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-blocco-action field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_47 js-view-dom-id-0497b7bde7803ed0440f81202c8bd98f6907acbe2675131ee4ea9b698ddf46d6">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-view"><span class="field-content"><div class="view view-paragrafi view-id-paragrafi view-display-id-block_1 js-view-dom-id-fb87a87892062af99cb7328ce87ab70599c17f32c018c65991c969f156c91379">
  
    
      
      <div class="view-content">
