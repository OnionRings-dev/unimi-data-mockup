                  <div class="tab-content">
                          <div id="ugov-of-pd-year-af-20270000bbmof2-BBM-0-0" class="tab-pane fade in active">
                
                                  
                                          <div class="top30 titoletto">Primo semestre</div>
                                            <table class="no-more-tables rs_content">
                        <thead>
                          <tr>
                            <th scope="col">Attività formative</th>
                            <th scope="col">Crediti massimi</th>
                            <th scope="col">Ore totali</th>
                            <th scope="col">Lingua</th>
                            <th scope="col">SSD</th>
                          </tr>
                        </thead>
                        <tbody>
                                                      <tr class="rowsubtitle ugov-of-pd-level2"><td colspan="5">Obbligatorio</td></tr>

                                                          <tr>
                                <td class="cdl-title" data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/constitutional-rights-migrants-comparative-perspective-0">Constitutional rights of migrants in a comparative perspective</a>
</td>
<td data-title="Crediti massimi">9</td>
<td data-title="Ore totali">60</td>
<td data-title="Lingua">Inglese</td>
<td data-title="SSD">GIUR-05/A GIUR-11/B</td>

                              </tr>
                                                          <tr>
                                <td class="cdl-title" data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/european-and-international-migration-law-0">European and international migration law</a>
</td>
<td data-title="Crediti massimi">9</td>
<td data-title="Ore totali">60</td>
<td data-title="Lingua">Inglese</td>
<td data-title="SSD">GIUR-09/A GIUR-10/A</td>

                              </tr>
                                                          <tr>
                                <td class="cdl-title" data-title="Attività formative">
<a href="/it/corsi/insegnamenti-dei-corsi-di-laurea/2027/geopolitics-migrations">Geopolitics of migrations</a>
</td>
<td data-title="Crediti massimi">6</td>
<td data-title="Ore totali">40</td>
<td data-title="Lingua">Inglese</td>
<td data-title="SSD">GSPS-02/A</td>

                              </tr>
