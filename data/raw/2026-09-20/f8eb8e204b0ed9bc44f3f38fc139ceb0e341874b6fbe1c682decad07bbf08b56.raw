      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-view"><span class="field-content"><div class="view view-paragrafi view-id-paragrafi view-display-id-block_1 js-view-dom-id-6f1c13a85b14e9cbdb7732d21f616447f341135e75674cd551663c2c157532d4">
  
    
      
