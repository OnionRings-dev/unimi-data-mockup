    <div id="edit-group-course-attendance--content" class="panel-body panel-collapse collapse fade">
            
            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-frequenza field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_10 js-view-dom-id-23b6dff824e55464b2b6f0b02728798acf7cc9c50adc18cbe96ed43112d5c548">
  
    
      
      <div class="view-content">
