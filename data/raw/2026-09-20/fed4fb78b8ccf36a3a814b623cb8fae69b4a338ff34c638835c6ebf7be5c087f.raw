  </div>
<div  class="paragraph paragraph--type--bp-accordion paragraph__column">
  <div class="bp-title">Manifesto ed elenco insegnamenti</div>
          <div  class="bottom20">
        
            <div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node view-id-w4_cdsi_to_node view-display-id-block_3 js-view-dom-id-a03a29adebc6b4595e708c77c9d712abf792d1d977d779d70ec1515c2ff74dde">
  
    
      
      <div class="view-content">
          <div class="padl30 views-row"><div><span class="file">
  <span class="file-icon" aria-hidden="true">
