            <div class="field field--name-dynamic-block-fieldnode-scheda-cds-action-informazione field--type-ds field--label-hidden field--item"><div class="views-element-container form-group"><div class="view view-w4-cdsi-to-node-2 view-id-w4_cdsi_to_node_2 view-display-id-block_4 js-view-dom-id-14cf9140d3c1bcf6ca497f9b3b060ad97e0d501bb60ee51efa34720e67eba3cc">
  
    
      
      <div class="view-content">
          <div><div class="views-field views-field-bando-al-informazione"><div class="field-content"><div class="paragraph paragraph--type--bp-card-action bgcolor-ebf0f6">
  <div class="card-content">
    <div class="bp-title">Per approfondire:</div>
<div class="actionlink-wrapper alw-of alw-info alw-1"><div class="actionlink al-informazione al-informazioni"><a href="https://www.unimi.it/it/node/92">Come iscriversi</a></div></div>
